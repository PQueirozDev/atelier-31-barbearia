# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Nunca commite o .env.local.

# URL do projeto, no formato https://<id>.supabase.co
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publicável (começa com sb_publishable_). É pública por design: o acesso
# aos dados é controlado pelas políticas de Row Level Security das migrações.
# Não use a chave secreta (service_role / sb_secret_) aqui.
VITE_SUPABASE_ANON_KEY=sb_publishable_sua-chave
